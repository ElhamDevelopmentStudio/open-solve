# Staging environment (mirrors production topology)
APP_URL=https://staging.opensolve.example
NEXT_PUBLIC_SITE_URL=https://staging.opensolve.example
DEPLOYMENT_ENVIRONMENT=staging
SESSION_SECRET=__INJECT_FROM_SECRET_MANAGER__
DATABASE_URL=postgresql://opensolve:__PASSWORD__@staging-db:5432/opensolve
DIRECT_URL=postgresql://opensolve_ro:__PASSWORD__@staging-db-replica:5432/opensolve
RESEND_API_KEY=__RESEND_KEY__
RESEND_FROM_EMAIL=staging@opensolve.example
GITHUB_CLIENT_ID=__GITHUB_CLIENT_ID__
GITHUB_CLIENT_SECRET=__GITHUB_CLIENT_SECRET__
GOOGLE_CLIENT_ID=__GOOGLE_CLIENT_ID__
GOOGLE_CLIENT_SECRET=__GOOGLE_CLIENT_SECRET__
AI_PROVIDER=
OPENAI_API_KEY=
OLLAMA_HOST=
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=opensolve-staging-assets
MINIO_ACCESS_KEY=opensolve
MINIO_SECRET_KEY=opensolve-secret
MINIO_ROOT_USER=opensolve
MINIO_ROOT_PASSWORD=opensolve-secret
MINIO_REGION=us-east-1
MINIO_USE_SSL=true
MINIO_PUBLIC_URL=https://static.staging.opensolve.example
JUDGE_RABBIT_URL=amqps://opensolve:__PASSWORD__@staging-rabbit:5671/vhost
JUDGE_RABBIT_PREFETCH=4
JUDGE_SANDBOX_DRIVER=docker
JUDGE_SANDBOX_WORKDIR=/var/lib/opensolve/judge
REALTIME_WORKER_TOKEN=__REALTIME_TOKEN__
SENTRY_DSN=__SENTRY_DSN__
SENTRY_ENVIRONMENT=staging
NEXT_PUBLIC_SENTRY_DSN=__SENTRY_PUBLIC_DSN__
METRICS_ACCESS_TOKEN=__PROM_TOKEN__
LOG_LEVEL=info
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=200
SENSITIVE_DATA_KEY=__SENSITIVE_KEY__
