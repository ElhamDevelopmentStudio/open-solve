# Production environment (never commit real secrets)
APP_URL=https://opensolve.example
NEXT_PUBLIC_SITE_URL=https://opensolve.example
DEPLOYMENT_ENVIRONMENT=production
SESSION_SECRET=__SECRET_MANAGER__:opensolve/session
DATABASE_URL=postgresql://opensolve:__PASSWORD__@prod-db:5432/opensolve
DIRECT_URL=postgresql://opensolve_ro:__PASSWORD__@prod-db-replica:5432/opensolve
RESEND_API_KEY=__SECRET_MANAGER__:opensolve/resend
RESEND_FROM_EMAIL=hello@opensolve.example
GITHUB_CLIENT_ID=__GITHUB_CLIENT_ID__
GITHUB_CLIENT_SECRET=__GITHUB_CLIENT_SECRET__
GOOGLE_CLIENT_ID=__GOOGLE_CLIENT_ID__
GOOGLE_CLIENT_SECRET=__GOOGLE_CLIENT_SECRET__
AI_PROVIDER=optional
OPENAI_API_KEY=__OPENAI_KEY__
OLLAMA_HOST=
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=opensolve-production-assets
MINIO_ACCESS_KEY=__IAM_ACCESS_KEY__
MINIO_SECRET_KEY=__IAM_SECRET_KEY__
MINIO_ROOT_USER=opensolve
MINIO_ROOT_PASSWORD=opensolve-secret
MINIO_REGION=us-east-1
MINIO_USE_SSL=true
MINIO_PUBLIC_URL=https://static.opensolve.example
JUDGE_RABBIT_URL=amqps://opensolve:__PASSWORD__@rabbitmq-prod:5671/opensolve
JUDGE_RABBIT_PREFETCH=6
JUDGE_SANDBOX_DRIVER=docker
JUDGE_SANDBOX_WORKDIR=/var/lib/opensolve/judge
REALTIME_WORKER_TOKEN=__SECRET_MANAGER__:opensolve/realtime
SENTRY_DSN=__SENTRY_DSN__
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_DSN=__SENTRY_PUBLIC_DSN__
METRICS_ACCESS_TOKEN=__PROM_TOKEN__
LOG_LEVEL=info
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=250
SENSITIVE_DATA_KEY=__SECRET_MANAGER__:opensolve/data-key
