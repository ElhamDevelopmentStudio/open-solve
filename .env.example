# Copy this file to `.env` and fill in the values.
# Only variables defined here are validated in `lib/env.ts` unless noted.

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opensolve?schema=public
# Optional: direct/read-only connection URL for Prisma (if used)
DIRECT_URL=

# --- Auth (NextAuth) ---
# 32+ char random string (e.g. `openssl rand -base64 32`)
NEXTAUTH_SECRET=
# Base URL of your app (needed by NextAuth in some flows)
NEXTAUTH_URL=http://localhost:3000

# --- OAuth Providers (optional) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- JWT Keys (required) ---
# Provide PEM keys as single-line with \n escapes.
# Example:
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# --- AI / LLM (optional) ---
# Set to `openai` or `ollama` when enabling AI features
AI_PROVIDER=
# Required when AI_PROVIDER=openai
OPENAI_API_KEY=
# Required when AI_PROVIDER=ollama (default local endpoint shown)
OLLAMA_HOST=http://localhost:11434

# --- Observability (optional) ---
SENTRY_DSN=
# Falls back to NODE_ENV if unset
SENTRY_ENVIRONMENT=development
# Client-side DSN (if exposing Sentry on the client)
NEXT_PUBLIC_SENTRY_DSN=

# --- App URLs (optional client usage) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Rate limiting (defaults shown) ---
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30

# --- Logging ---
# One of: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# --- Judge system ---
JUDGE_RABBIT_URL=amqp://opensolve:opensolve@localhost:5672
JUDGE_RABBIT_PREFETCH=2
JUDGE_SANDBOX_DRIVER=docker
JUDGE_SANDBOX_WORKDIR=/tmp/opensolve-judge
REALTIME_WORKER_TOKEN=dev-realtime-token

# --- Tooling ---
# Set to `true` to bypass env validation (development only)
SKIP_ENV_VALIDATION=

# --- Extras referenced outside lib/env.ts (optional) ---
# Used by Sentry source maps upload (next.config.ts)
# SENTRY_ORG=
# SENTRY_PROJECT=
# Used by client instrumentation fallback logic
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# --- MinIO / S3-compatible storage (optional) ---
# Example for local MinIO without TLS:
# MINIO_ENDPOINT=localhost:9000
# MINIO_BUCKET=opensolve
# MINIO_ACCESS_KEY=minio
# MINIO_SECRET_KEY=miniosecret
# MINIO_REGION=us-east-1
# MINIO_USE_SSL=false
# Public URL base if bucket is exposed via CDN or reverse proxy (optional):
# MINIO_PUBLIC_URL=http://localhost:9000
SENSITIVE_DATA_KEY=please-change-this-demo-key-32-chars
METRICS_ACCESS_TOKEN=optional-prometheus-bearer
