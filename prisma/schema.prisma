generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                   @id @default(cuid())
  email                String                   @unique
  emailVerified        DateTime?
  name                 String?
  handle               String                   @unique
  hashedPassword       String?
  avatarUrl            String?
  bio                  String?
  country              String?
  timezone             String?
  socialGithub         String?
  socialLinkedin       String?
  socialTwitter        String?
  socialWebsite        String?
  shareAcceptedCode    Boolean                  @default(false)
  showOnLeaderboard    Boolean                  @default(true)
  showCountry          Boolean                  @default(true)
  showSocials          Boolean                  @default(true)
  role                 UserRole                 @default(USER)
  twoFactorEnabled     Boolean                  @default(false)
  lastLoginAt          DateTime?
  bannedAt             DateTime?
  passwordUpdatedAt    DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  deletedAt            DateTime?
  status               UserStatus               @default(ACTIVE)
  accounts             Account[]
  auditLogs            AuthAuditLog[]
  badgeAwards          BadgeAward[]
  contestRegistrations ContestRegistration[]
  discussions          Discussion[]
  lockedDiscussions    Discussion[]          @relation("DiscussionLockedBy")
  discussionReportsFiled DiscussionReport[]  @relation("DiscussionReporter")
  discussionReportsResolved DiscussionReport[] @relation("DiscussionResolver")
  leaderboardEntries   LeaderboardEntry[]
  createdProblems      Problem[]                @relation("ProblemAuthor")
  curatedProblems      ProblemCurator[]
  proposalsAuthored    ProblemProposal[]        @relation("ProblemProposalAuthor")
  proposalsReviewed    ProblemProposal[]        @relation("ProblemProposalReviewer")
  proposalComments     ProblemProposalComment[] @relation("ProblemProposalCommentAuthor")
  problemReviews       ProblemReview[]          @relation("UserProblemReviews")
  sessions             Session[]
  manualReviews        Submission[]             @relation("SubmissionManualReviewer")
  submissions          Submission[]
  submissionDrafts     SubmissionDraft[]
  recoveryCodes        TwoFactorRecoveryCode[]
  twoFactorSecret      TwoFactorSecret?
  stats                UserStats?
  votes                Vote[]
  trailInsights        TrailInsight[]
  trailInsightVotes    TrailInsightVote[]
  trailReportsFiled    TrailReport[]           @relation("TrailReportReporter")
  trailReportsResolved TrailReport[]           @relation("TrailReportResolver")
  leaderboardRealtimeSolves LeaderboardRealtimeSolve[]

  @@index([handle])
  @@index([status, role])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id                  String   @id @default(cuid())
  sessionToken        String   @unique
  refreshToken        String   @unique
  refreshTokenExpires DateTime
  userId              String
  userAgent           String?
  ipAddress           String?
  lastUsedAt          DateTime @default(now())
  twoFactorVerified   Boolean  @default(false)
  expires             DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  type       String   @default("magic_link")
  expires    DateTime
  createdAt  DateTime @default(now())
  userId     String?

  @@unique([identifier, token])
}

model EmailMessage {
  id              String    @id @default(cuid())
  userId          String?
  type            String
  templateVersion String
  resendMessageId String?
  to              String
  status          String    @default("pending")
  providerReason  String?
  createdAt       DateTime  @default(now())
  sentAt          DateTime?
  deliveredAt     DateTime?
  failureAt       DateTime?

  @@index([userId, createdAt])
  @@index([status])
}

model EmailSuppression {
  email     String   @id
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RateLimitLedger {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@index([expiresAt])
}

model TwoFactorSecret {
  userId    String   @id
  secret    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TwoFactorRecoveryCode {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
}

model AuthAuditLog {
  id        String          @id @default(cuid())
  userId    String?
  action    AuthAuditAction
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime        @default(now())
  user      User?           @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model UserStats {
  userId        String    @id
  totalSolved   Int       @default(0)
  solvedEasy    Int       @default(0)
  solvedMedium  Int       @default(0)
  solvedHard    Int       @default(0)
  streakCount   Int       @default(0)
  firstAcAt     DateTime?
  lastAcAt      DateTime?
  languagesUsed String[]  @default([])
  createdById   String?
  updatedById   String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Difficulty {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  weight      Int
  description String?
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  problems    Problem[]
}

model Tag {
  id          String       @id @default(cuid())
  name        String       @unique
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  category    String?
  createdById String?
  deletedAt   DateTime?
  isFeatured  Boolean      @default(false)
  updatedById String?
  problems    ProblemTag[]
  discussionTags DiscussionTag[]
  stats       TagStats?

  @@index([category, isFeatured])
}

model TagStats {
  id            String    @id @default(cuid())
  tagId         String    @unique
  problemCount  Int       @default(0)
  solvedByCount Int       @default(0)
  createdById   String?
  updatedById   String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tag           Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)
}

model Company {
  id          String           @id @default(cuid())
  name        String           @unique
  slug        String           @unique
  isHidden    Boolean          @default(false)
  logoUrl     String?
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  stats       CompanyStats?
  problems    ProblemCompany[]

  @@index([isHidden])
}

model CompanyStats {
  id           String    @id @default(cuid())
  companyId    String    @unique
  problemCount Int       @default(0)
  createdById  String?
  updatedById  String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Problem {
  id               String            @id @default(cuid())
  slug             String            @unique
  authorId         String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  judgeMode        ProblemJudgeMode  @default(AUTO)
  createdById      String?
  currentVersionId String?           @unique
  deletedAt        DateTime?
  difficultyId     String?
  state            ProblemState      @default(DRAFT)
  updatedById      String?
  visibility       ProblemVisibility @default(INTERNAL)
  editorialReleaseStrategy EditorialReleaseStrategy @default(ON_PUBLISH)
  editorialReleaseAt DateTime?
  editorialReleasedAt DateTime?
  editorialReleaseOffsetDays Int?
  editorialReleaseContestId String?
  contestProblems  ContestProblem[]
  discussions      Discussion[]
  editorialReleaseContest Contest? @relation("ContestEditorialRelease", fields: [editorialReleaseContestId], references: [id], onDelete: SetNull)
  author           User              @relation("ProblemAuthor", fields: [authorId], references: [id])
  currentVersion   ProblemVersion?   @relation("ProblemCurrentVersion", fields: [currentVersionId], references: [id])
  difficulty       Difficulty?       @relation(fields: [difficultyId], references: [id])
  companies        ProblemCompany[]
  curators         ProblemCurator[]
  languages        ProblemLanguage[]
  reviews          ProblemReview[]   @relation("ProblemReviews")
  stats            ProblemStats?
  tags             ProblemTag[]
  versions         ProblemVersion[]
  submissions      Submission[]
  submissionDrafts SubmissionDraft[]
  trailInsights    TrailInsight[]
  trailEdges       TrailEdge[]
  leaderboardRealtimeSolves LeaderboardRealtimeSolve[]

  @@index([state, visibility, difficultyId, createdAt])
}

model ProblemVersion {
  id                String           @id @default(cuid())
  problemId         String
  versionNumber     Int
  title             String
  statement         String
  constraints       String
  hints             String?
  editorial         String?
  samples           Json
  dataHash          String?
  createdById       String?
  updatedById       String?
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  contestUsages     ContestProblem[]
  currentForProblem Problem?         @relation("ProblemCurrentVersion")
  problem           Problem          @relation(fields: [problemId], references: [id], onDelete: Cascade)
  submissions       Submission[]
  testCases         TestCase[]

  @@unique([problemId, versionNumber])
  @@index([dataHash])
}

model ProblemTag {
  problemId   String
  tagId       String
  createdAt   DateTime  @default(now())
  createdById String?
  deletedAt   DateTime?
  updatedAt   DateTime  @updatedAt
  updatedById String?
  problem     Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([problemId, tagId])
}

model ProblemCompany {
  problemId   String
  companyId   String
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  problem     Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@id([problemId, companyId])
}

model ProblemCurator {
  id          String    @id @default(cuid())
  problemId   String
  userId      String
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  problem     Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([problemId, userId])
}

model ProblemLanguage {
  id           String    @id @default(cuid())
  problemId    String
  languageCode String
  codeStub     String?
  createdById  String?
  updatedById  String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  language     Language  @relation(fields: [languageCode], references: [code])
  problem      Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, languageCode])
}

model ProblemStats {
  id              String    @id @default(cuid())
  problemId       String    @unique
  acceptedCount   Int       @default(0)
  submissionCount Int       @default(0)
  favoriteCount   Int       @default(0)
  acceptanceRate  Float     @default(0)
  createdById     String?
  updatedById     String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  problem         Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

model ProblemReview {
  id         String                @id @default(cuid())
  problemId  String
  reviewerId String
  decision   ProblemReviewDecision
  notes      String?
  createdAt  DateTime              @default(now())
  problem    Problem               @relation("ProblemReviews", fields: [problemId], references: [id], onDelete: Cascade)
  reviewer   User                  @relation("UserProblemReviews", fields: [reviewerId], references: [id])

  @@index([problemId])
  @@index([reviewerId])
}

model ProblemProposal {
  id                   String                   @id @default(cuid())
  slug                 String                   @unique
  title                String
  intendedDifficulty   String?
  statement            String
  samples              Json
  originalityConfirmed Boolean                  @default(false)
  status               ProblemProposalStatus    @default(SUBMITTED)
  authorId             String
  reviewerId           String?
  convertedProblemId   String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  author               User                     @relation("ProblemProposalAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reviewer             User?                    @relation("ProblemProposalReviewer", fields: [reviewerId], references: [id])
  comments             ProblemProposalComment[]

  @@index([status])
  @@index([authorId])
  @@index([reviewerId])
}

model ProblemProposalComment {
  id         String          @id @default(cuid())
  proposalId String
  authorId   String
  body       String
  createdAt  DateTime        @default(now())
  author     User            @relation("ProblemProposalCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  proposal   ProblemProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@index([authorId])
}

model TestCase {
  id               String         @id @default(cuid())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  inputData        String?
  outputData       String?
  checksum         String?
  createdById      String?
  deletedAt        DateTime?
  inputBlobRef     String
  kind             TestCaseKind   @default(HIDDEN)
  memoryLimitMb    Int
  ordinal          Int
  outputBlobRef    String
  problemVersionId String
  timeLimitMs      Int
  updatedById      String?
  strength         Int            @default(0)
  problemVersion   ProblemVersion @relation(fields: [problemVersionId], references: [id], onDelete: Cascade)

  @@index([problemVersionId, kind, ordinal])
}

model Language {
  code               String            @id
  displayName        String
  compileCmd         String
  runCmd             String
  timeMultiplier     Float             @default(1)
  memoryCeilingMb    Int
  fileExtension      String
  isEnabled          Boolean           @default(true)
  sandboxProfile     String?
  createdById        String?
  updatedById        String?
  deletedAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  problemAssignments ProblemLanguage[]
  submissions        Submission[]
  submissionDrafts   SubmissionDraft[]

  @@index([isEnabled])
}

model Verdict {
  code        String                 @id
  label       String
  rank        Int
  isTerminal  Boolean                @default(true)
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  submissions Submission[]
  caseResults SubmissionCaseResult[]
}

model Submission {
  id                   String                 @id @default(cuid())
  userId               String
  problemId            String
  status               SubmissionStatus       @default(QUEUED)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  manualDueAt          DateTime?
  manualNotes          String?
  manualReviewedAt     DateTime?
  manualReviewerId     String?
  manualScore          Float?
  requiresManualReview Boolean                @default(false)
  codeHash             String
  isShareEnabled       Boolean                @default(false)
  sharePublicId        String?                @unique
  shareEnabledAt       DateTime?
  shareRevokedAt       DateTime?
  hiddenFromProfile    Boolean                @default(false)
  contestId            String?
  createdById          String?
  deletedAt            DateTime?
  finishedAt           DateTime?
  judgeNodeId          String?
  languageCode         String
  memoryUsedKb         Int?
  metadata             Json?
  problemVersionId     String?
  queuedAt             DateTime               @default(now())
  score                Float?
  sourceCodeRef        String
  startedAt            DateTime?
  timeUsedMs           Int?
  updatedById          String?
  verdictCode          String?
  contest              Contest?               @relation(fields: [contestId], references: [id])
  language             Language               @relation(fields: [languageCode], references: [code])
  manualReviewer       User?                  @relation("SubmissionManualReviewer", fields: [manualReviewerId], references: [id])
  problem              Problem                @relation(fields: [problemId], references: [id], onDelete: Cascade)
  problemVersion       ProblemVersion?        @relation(fields: [problemVersionId], references: [id])
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  verdict              Verdict?               @relation(fields: [verdictCode], references: [code])
  caseResults          SubmissionCaseResult[]
  leaderboardRealtimeSolves LeaderboardRealtimeSolve[]

  @@index([userId, problemId, createdAt])
  @@index([problemId, verdictCode, createdAt])
  @@index([codeHash])
  @@index([status, requiresManualReview])
}

model SubmissionCaseResult {
  id           String     @id @default(cuid())
  submissionId String
  testOrdinal  Int
  verdictCode  String?
  timeMs       Int?
  memoryKb     Int?
  stderrRef    String?
  createdById  String?
  updatedById  String?
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  verdict      Verdict?   @relation(fields: [verdictCode], references: [code])

  @@unique([submissionId, testOrdinal])
}

model SubmissionDraft {
  id           String   @id @default(cuid())
  userId       String
  problemId    String
  languageCode String
  sourceCode   String
  cursorOffset Int      @default(0)
  notes        String?
  savedVia     String   @default("autosave")
  sourceHash   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  language     Language @relation(fields: [languageCode], references: [code])
  problem      Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, problemId, languageCode, createdAt])
  @@index([problemId, languageCode, createdAt])
}

model Discussion {
  id             String              @id @default(cuid())
  problemId      String?
  authorId       String
  parentId       String?
  title          String?
  content        String
  category       DiscussionCategory?
  containsSpoiler Boolean            @default(false)
  score          Int                 @default(0)
  state          DiscussionState     @default(VISIBLE)
  isPinned       Boolean             @default(false)
  isLocked       Boolean             @default(false)
  lockedAt       DateTime?
  lockedById     String?
  replyCount     Int                 @default(0)
  lastActivityAt DateTime            @default(now())
  editedAt       DateTime?
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  author         User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent         Discussion?         @relation("DiscussionReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        Discussion[]        @relation("DiscussionReplies")
  problem        Problem?            @relation(fields: [problemId], references: [id], onDelete: Cascade)
  lockedBy       User?               @relation("DiscussionLockedBy", fields: [lockedById], references: [id])
  tags           DiscussionTag[]
  votes          Vote[]
  reports        DiscussionReport[]

  @@index([problemId, parentId])
  @@index([category, lastActivityAt])
  @@index([problemId, score, createdAt])
}

model DiscussionTag {
  discussionId String
  tagId        String
  createdAt    DateTime   @default(now())
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  tag          Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([discussionId, tagId])
}

model DiscussionReport {
  id           String                 @id @default(cuid())
  discussionId String
  reporterId   String
  reason       DiscussionReportReason
  status       DiscussionReportStatus @default(OPEN)
  note         String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  discussion   Discussion            @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  reporter     User                  @relation("DiscussionReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolver     User?                 @relation("DiscussionResolver", fields: [resolvedById], references: [id])

  @@index([status, createdAt])
}

model Vote {
  id           String     @id @default(cuid())
  discussionId String
  userId       String
  value        Int
  createdById  String?
  updatedById  String?
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([discussionId, userId])
}

model TrailInsight {
  id          String               @id @default(cuid())
  problemId   String
  authorId    String
  content     String
  category    TrailInsightCategory @default(IDEA)
  score       Int                  @default(0)
  isHidden    Boolean              @default(false)
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  problem     Problem              @relation(fields: [problemId], references: [id], onDelete: Cascade)
  author      User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes       TrailInsightVote[]
  outgoing    TrailEdge[]          @relation("TrailEdgeFrom")
  incoming    TrailEdge[]          @relation("TrailEdgeTo")
  reports     TrailReport[]

  @@index([problemId, score, createdAt])
}

model TrailEdge {
  id            String       @id @default(cuid())
  problemId     String
  fromInsightId String
  toInsightId   String
  weight        Int          @default(1)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  problem       Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  fromInsight   TrailInsight @relation("TrailEdgeFrom", fields: [fromInsightId], references: [id], onDelete: Cascade)
  toInsight     TrailInsight @relation("TrailEdgeTo", fields: [toInsightId], references: [id], onDelete: Cascade)

  @@unique([problemId, fromInsightId, toInsightId])
  @@index([problemId, fromInsightId, weight])
}

model TrailInsightVote {
  id         String        @id @default(cuid())
  insightId  String
  userId     String
  value      Int
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  insight    TrailInsight  @relation(fields: [insightId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([insightId, userId])
}

model TrailReport {
  id           String             @id @default(cuid())
  insightId    String
  reporterId   String
  reason       TrailReportReason
  status       TrailReportStatus  @default(OPEN)
  note         String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  insight      TrailInsight       @relation(fields: [insightId], references: [id], onDelete: Cascade)
  reporter     User               @relation("TrailReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolver     User?              @relation("TrailReportResolver", fields: [resolvedById], references: [id])

  @@index([status, createdAt])
}

model Badge {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String?
  icon        String?
  criteria    Json
  isHidden    Boolean      @default(false)
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  awards      BadgeAward[]
}

model BadgeAward {
  id          String           @id @default(cuid())
  badgeId     String
  userId      String
  awardedAt   DateTime         @default(now())
  source      BadgeAwardSource @default(SYSTEM)
  metadata    Json?
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  badge       Badge            @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([badgeId, userId])
}

model LeaderboardSnapshot {
  id          String             @id @default(cuid())
  createdAt   DateTime           @default(now())
  createdById String?
  deletedAt   DateTime?
  generatedAt DateTime           @default(now())
  periodEnd   DateTime?
  periodStart DateTime
  updatedAt   DateTime           @updatedAt
  updatedById String?
  window      String
  entries     LeaderboardEntry[]
  realtimeSolves LeaderboardRealtimeSolve[]

  @@unique([window, periodStart])
}

model LeaderboardEntry {
  id          String              @id @default(cuid())
  snapshotId  String
  rank        Int
  userId      String
  score       Float
  solved      Int
  timePenalty Int?
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  snapshot    LeaderboardSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, rank])
  @@unique([snapshotId, userId])
}

model LeaderboardRealtimeSolve {
  id           String              @id @default(cuid())
  snapshotId   String
  window       String
  userId       String
  problemId    String
  submissionId String
  score        Float              @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  snapshot     LeaderboardSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem      Problem            @relation(fields: [problemId], references: [id], onDelete: Cascade)
  submission   Submission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, userId, problemId])
  @@index([snapshotId, window])
  @@index([userId, window])
  @@index([submissionId])
}

model Contest {
  id                 String                @id @default(cuid())
  slug               String                @unique
  name               String
  description        String?
  state              ContestState          @default(UPCOMING)
  visibility         ContestVisibility     @default(PUBLIC)
  startsAt           DateTime
  endsAt             DateTime
  freezeAt           DateTime?
  rules              ContestRuleset        @default(ICPC)
  isRated            Boolean               @default(false)
  editorialReleaseAt DateTime?
  createdById        String?
  updatedById        String?
  deletedAt          DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  problems           ContestProblem[]
  editorialReleaseProblems Problem[]        @relation("ContestEditorialRelease")
  registrations      ContestRegistration[]
  submissions        Submission[]

  @@index([state, startsAt])
}

model ContestProblem {
  id          String         @id @default(cuid())
  contestId   String
  problemId   String
  versionId   String
  label       String
  order       Int
  points      Int?
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  contest     Contest        @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problem     Problem        @relation(fields: [problemId], references: [id], onDelete: Cascade)
  version     ProblemVersion @relation(fields: [versionId], references: [id])

  @@unique([contestId, order])
  @@unique([contestId, problemId])
}

model ContestRegistration {
  id           String    @id @default(cuid())
  contestId    String
  userId       String
  registeredAt DateTime  @default(now())
  isVirtual    Boolean   @default(false)
  createdById  String?
  updatedById  String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  contest      Contest   @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
}

